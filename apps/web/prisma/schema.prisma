generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  ADMIN
  AGENT
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum ProductSource {
  MANUAL
  CRAWL
  IMPORT
}

enum KnowledgeType {
  FAQ
  POLICY
  DOCUMENT
}

enum EmbeddingSourceType {
  PRODUCT
  KNOWLEDGE_ENTRY
}

enum BuyingStage {
  EXPLORING
  COMPARING
  PURCHASE_READY
  PURCHASED
}

enum Channel {
  WEBSITE
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  EMAIL
}

enum ConversationStatus {
  ACTIVE
  ENDED
  HANDED_OFF
}

enum ConversationOutcome {
  PENDING
  PURCHASED
  RESOLVED
  ABANDONED
}

enum MessageRole {
  CUSTOMER
  AI
  SYSTEM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum IntegrationStatus {
  PENDING
  CONNECTED
  ERROR
  DISABLED
}

enum WebsiteStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum WebsiteVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum WebsiteCrawlStatus {
  NOT_STARTED
  CRAWLING
  INDEXING
  READY
  FAILED
}

enum CrawlStatus {
  QUEUED
  RUNNING
  CANCELLING
  CANCELLED
  COMPLETED
  FAILED
  PARTIAL
}

enum CrawlTrigger {
  MANUAL
  SCHEDULED
  CLAIM
  REINDEX
}

enum CrawlPageType {
  PRODUCT
  CATEGORY
  POLICY
  FAQ
  ABOUT
  CONTACT
  BLOG
  OTHER
}

enum CrawlFrontierStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

// ─────────────────────────────────────────────────────────────
// Tenancy & identity
// ─────────────────────────────────────────────────────────────

model Organization {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  slug       String   @unique
  websiteUrl String?  @map("website_url")
  industry   String?
  country    String   @default("Nigeria")
  currency   String   @default("NGN")
  logoUrl    String?  @map("logo_url")
  settings   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  users               User[]
  categories          Category[]
  products            Product[]
  knowledgeEntries    KnowledgeEntry[]
  embeddings          Embedding[]
  customers           Customer[]
  conversations       Conversation[]
  customerEvents      CustomerEvent[]
  widgetKeys          WidgetKey[]
  subscription        Subscription?
  usageRecords        UsageRecord[]
  channelIntegrations ChannelIntegration[]
  supportTickets      SupportTicket[]
  websites            WebsiteRegistry[]
  crawls              Crawl[]
  pages               WebsitePage[]
  crawlFrontier       CrawlFrontier[]
  productVariants     ProductVariant[]
  carts               Cart[]
  attributedOrders    AttributedOrder[]
  abandonedCarts      AbandonedCart[]
  shopperSessions     ShopperSession[]
  productPerformanceMetrics ProductPerformanceMetric[]
  intentProductPerformances IntentProductPerformance[]
  conversationSignals       ConversationSignal[]
  experiments               Experiment[]
  experimentAssignments     ExperimentAssignment[]
  rankingModels             RankingModel[]

  @@map("organizations")
}

model WebsiteRegistry {
  id                 String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId              String                       @map("org_id") @db.Uuid
  normalizedUrl      String                       @unique @map("normalized_url")
  originalUrl        String                       @map("original_url")
  status             WebsiteStatus                @default(ACTIVE)
  verificationStatus WebsiteVerificationStatus     @default(UNVERIFIED) @map("verification_status")
  crawlStatus        WebsiteCrawlStatus            @default(NOT_STARTED) @map("crawl_status")
  lastCrawledAt      DateTime?                    @map("last_crawled_at") @db.Timestamptz
  createdAt          DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  brandTheme BrandTheme?
  crawls Crawl[]
  pages WebsitePage[]
  crawlFrontier CrawlFrontier[]

  @@index([orgId])
  @@map("website_registry")
}

// ─────────────────────────────────────────────────────────────
// Website Intelligence (Phase 2 — crawl orchestration)
// ─────────────────────────────────────────────────────────────

model Crawl {
  id                         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                      String                 @map("org_id") @db.Uuid
  websiteId                  String                 @map("website_id") @db.Uuid
  status                     CrawlStatus            @default(QUEUED)
  trigger                    CrawlTrigger           @default(MANUAL)
  startedAt                  DateTime?              @map("started_at") @db.Timestamptz
  completedAt                DateTime?              @map("completed_at") @db.Timestamptz
  cancelledAt                DateTime?              @map("cancelled_at") @db.Timestamptz
  error                      String?
  pagesDiscovered            Int                    @default(0) @map("pages_discovered")
  pagesProcessed             Int                    @default(0) @map("pages_processed")
  pagesFailed                Int                    @default(0) @map("pages_failed")
  productsDiscovered         Int                    @default(0) @map("products_discovered")
  productsCreated            Int                    @default(0) @map("products_created")
  productsUpdated            Int                    @default(0) @map("products_updated")
  productsRemoved            Int                    @default(0) @map("products_removed")
  knowledgeEntriesProcessed  Int                    @default(0) @map("knowledge_entries_processed")
  createdAt                  DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  org      Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  website  WebsiteRegistry @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  pages    WebsitePage[]
  frontier CrawlFrontier[]

  @@index([orgId, createdAt])
  @@index([websiteId, status])
  @@index([status, createdAt])
  @@map("crawls")
}

model WebsitePage {
  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                   String        @map("org_id") @db.Uuid
  websiteId               String        @map("website_id") @db.Uuid
  crawlId                 String        @map("crawl_id") @db.Uuid
  url                     String
  canonicalUrl            String        @map("canonical_url")
  pageType                CrawlPageType @default(OTHER) @map("page_type")
  title                   String?
  contentHash             String?       @map("content_hash")
  httpStatus              Int?          @map("http_status")
  contentType             String?       @map("content_type")
  discoveredFrom          String?       @map("discovered_from")
  depth                   Int           @default(0)
  lastCrawledAt           DateTime      @default(now()) @map("last_crawled_at") @db.Timestamptz
  lastSuccessfulCrawlAt   DateTime?     @map("last_successful_crawl_at") @db.Timestamptz
  metadata                Json          @default("{}")
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  org      Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  website  WebsiteRegistry @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  crawl    Crawl           @relation(fields: [crawlId], references: [id], onDelete: Cascade)

  @@unique([orgId, canonicalUrl])
  @@index([websiteId, pageType])
  @@index([crawlId])
  @@map("website_pages")
}

model CrawlFrontier {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  crawlId        String              @map("crawl_id") @db.Uuid
  orgId          String              @map("org_id") @db.Uuid
  websiteId      String              @map("website_id") @db.Uuid
  url            String
  normalizedUrl  String              @map("normalized_url")
  depth          Int                 @default(0)
  priority       Int                 @default(0)
  discoveredFrom String?             @map("discovered_from")
  status         CrawlFrontierStatus @default(PENDING)
  attempts       Int                 @default(0)
  scheduledAt    DateTime            @default(now()) @map("scheduled_at") @db.Timestamptz
  processedAt    DateTime?           @map("processed_at") @db.Timestamptz
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz

  crawl   Crawl           @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  org     Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  website WebsiteRegistry @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([crawlId, normalizedUrl])
  @@index([crawlId, status, priority])
  @@index([orgId, status])
  @@map("crawl_frontier")
}

model User {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String?       @map("org_id") @db.Uuid
  email         String        @unique
  passwordHash  String        @map("password_hash")
  name          String
  role          UserRole      @default(AGENT)
  avatarUrl     String?       @map("avatar_url")
  emailVerified Boolean       @default(false) @map("email_verified")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  org           Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sessions      Session[]

  @@index([orgId])
  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  // SHA-256 of the random session token — never store the raw token.
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model WidgetKey {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  publicKey      String   @unique @map("public_key")
  label          String   @default("Default")
  allowedDomains String[] @default([]) @map("allowed_domains")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("widget_keys")
}

// ─────────────────────────────────────────────────────────────
// Catalog & knowledge
// ─────────────────────────────────────────────────────────────

model Category {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId             String   @map("org_id") @db.Uuid
  name              String
  slug              String?
  image             String?
  icon              String?
  displayOrder      Int      @default(0) @map("display_order")
  // Ordered qualification steps the widget walks for this category, e.g.
  // [{ id, key, question, type: "single"|"budget", options:[{label,value,icon?}] }].
  // Never hardcoded in the widget — see server/widget/qualificationTemplates.ts.
  qualificationFlow Json     @default("[]") @map("qualification_flow")
  parentId          String?  @map("parent_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent   Category?    @relation("SubCategories", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]   @relation("SubCategories")
  products Product[]

  @@unique([orgId, name])
  @@map("categories")
}

model Product {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String          @map("org_id") @db.Uuid
  categoryId      String?         @map("category_id") @db.Uuid
  name            String
  brand           String?
  description     String?
  price           Decimal         @db.Decimal(12, 2)
  currency        String          @default("NGN")
  images          Json            @default("[]")
  attributes      Json            @default("{}")
  inventoryStatus InventoryStatus @default(IN_STOCK) @map("inventory_status")
  source          ProductSource   @default(MANUAL)
  sourceUrl       String?         @map("source_url")
  aiDescription   String?         @map("ai_description")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  org      Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants ProductVariant[]
  cartItems CartItem[]
  performanceMetrics ProductPerformanceMetric[]
  intentPerformances IntentProductPerformance[]

  @@index([orgId, createdAt])
  @@index([orgId, categoryId])
  @@index([orgId, brand])
  @@map("products")
}

model ProductVariant {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId         String          @map("product_id") @db.Uuid
  orgId             String          @map("org_id") @db.Uuid
  sku               String?
  name              String?
  price             Decimal?        @db.Decimal(12, 2)
  currency          String          @default("NGN")
  attributes        Json            @default("{}")
  inventoryStatus   InventoryStatus @default(IN_STOCK) @map("inventory_status")
  inventoryQuantity Int?            @map("inventory_quantity")
  images            Json            @default("[]")
  sourceUrl         String?         @map("source_url")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@index([productId])
  @@index([orgId])
  @@map("product_variants")
}

model KnowledgeEntry {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String        @map("org_id") @db.Uuid
  type      KnowledgeType
  title     String
  content   String
  metadata  Json          @default("{}")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, type])
  @@map("knowledge_entries")
}

model Embedding {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String              @map("org_id") @db.Uuid
  sourceType EmbeddingSourceType @map("source_type")
  sourceId   String              @map("source_id") @db.Uuid
  chunkIndex Int                 @default(0) @map("chunk_index")
  chunkText  String              @map("chunk_text")
  // Dimension matches Voyage AI voyage-3-large default output (1024).
  embedding  Unsupported("vector(1024)")?
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId, chunkIndex])
  @@index([orgId, sourceType])
  @@map("embeddings")
}

// ─────────────────────────────────────────────────────────────
// Customers & conversations
// ─────────────────────────────────────────────────────────────

model Customer {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String      @map("org_id") @db.Uuid
  externalId  String?     @map("external_id")
  name        String?
  email       String?
  phone       String?
  preferences Json        @default("[]")
  buyingStage BuyingStage @default(EXPLORING) @map("buying_stage")
  firstSeen   DateTime    @default(now()) @map("first_seen") @db.Timestamptz
  lastSeen    DateTime    @default(now()) @map("last_seen") @db.Timestamptz

  org            Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversations  Conversation[]
  customerEvents CustomerEvent[]
  carts          Cart[]
  attributedOrders AttributedOrder[]
  abandonedCarts   AbandonedCart[]
  shopperSessions  ShopperSession[]

  @@unique([orgId, externalId])
  @@index([orgId, lastSeen])
  @@map("customers")
}

model Conversation {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String              @map("org_id") @db.Uuid
  customerId   String              @map("customer_id") @db.Uuid
  channel      Channel             @default(WEBSITE)
  status       ConversationStatus  @default(ACTIVE)
  startedAt    DateTime            @default(now()) @map("started_at") @db.Timestamptz
  endedAt      DateTime?           @map("ended_at") @db.Timestamptz
  summary      String?
  intent       String              @default("greeting")
  aiConfidence Int                 @default(100) @map("ai_confidence")
  outcome      ConversationOutcome @default(PENDING)
  // Shopping-funnel state: { categoryId, categoryName, budget:{min,max},
  // brand, answers:{}, viewedProductIds:[], funnelStep }. Grounds AI chat
  // turns and lets a returning visitor resume without repeating themselves.
  context      Json                @default("{}")

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages Message[]
  carts    Cart[]
  attributedOrders AttributedOrder[]
  abandonedCarts AbandonedCart[]

  @@index([orgId, startedAt])
  @@index([customerId])
  @@map("conversations")
}

model Message {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId  String      @map("conversation_id") @db.Uuid
  role            MessageRole
  content         String
  intent          String?
  recommendations Json        @default("[]")
  inputTokens     Int         @default(0) @map("input_tokens")
  outputTokens    Int         @default(0) @map("output_tokens")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model CustomerEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  eventType  String   @map("event_type")
  pageUrl    String?  @map("page_url")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([customerId, createdAt])
  @@map("customer_events")
}

// ─────────────────────────────────────────────────────────────
// Milestone D — Customer Intelligence & Shopper Session
// ─────────────────────────────────────────────────────────────

model ShopperSession {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId               String    @map("org_id") @db.Uuid
  sessionId           String    @unique @map("session_id")
  customerId          String?   @map("customer_id") @db.Uuid
  isAnonymous         Boolean   @default(true) @map("is_anonymous")
  journeyState        String    @default("DISCOVERY") @map("journey_state")
  intentStage         String    @default("INITIAL") @map("intent_stage")
  currentIntent       String?   @map("current_intent")
  intentConstraints   Json      @default("{}") @map("intent_constraints")
  scores              Json      @default("{}")
  explicitPreferences Json      @default("{}") @map("explicit_preferences")
  inferredPreferences Json      @default("{}") @map("inferred_preferences")
  categoriesViewed    Json      @default("[]") @map("categories_viewed")
  productsViewed      Json      @default("[]") @map("products_viewed")
  productsCompared    Json      @default("[]") @map("products_compared")
  shortlist           Json      @default("[]")
  pageContext         Json      @default("{}") @map("page_context")
  segment             String    @default("NEW_VISITOR")
  lastActivityAt      DateTime  @default(now()) @updatedAt @map("last_activity_at") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt           DateTime? @map("expires_at") @db.Timestamptz

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([orgId, sessionId])
  @@index([orgId, customerId])
  @@index([orgId, lastActivityAt])
  @@map("shopper_sessions")
}

// ─────────────────────────────────────────────────────────────
// Billing & usage
// ─────────────────────────────────────────────────────────────

model Plan {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String  @unique // "starter" | "growth" | "pro"
  name              String
  priceMonthly      Decimal @map("price_monthly") @db.Decimal(12, 2)
  currency          String  @default("NGN")
  paystackPlanCode  String? @map("paystack_plan_code")
  monthlyMessageCap Int     @map("monthly_message_cap")
  productCap        Int     @map("product_cap")
  channelCap        Int     @default(1) @map("channel_cap")
  knowledgeCap      Int     @default(10) @map("knowledge_cap")
  active            Boolean @default(true)

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                    String             @unique @map("org_id") @db.Uuid
  planId                   String             @map("plan_id") @db.Uuid
  status                   SubscriptionStatus @default(TRIALING)
  paystackCustomerCode     String?            @map("paystack_customer_code")
  paystackSubscriptionCode String?            @map("paystack_subscription_code")
  trialEndsAt              DateTime?          @map("trial_ends_at") @db.Timestamptz
  currentPeriodEnd         DateTime?          @map("current_period_end") @db.Timestamptz
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan Plan         @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model UsageRecord {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId    String   @map("org_id") @db.Uuid
  metric   String // "ai_messages" | "embedding_tokens" | ...
  quantity Int
  period   String // "2026-07" (yyyy-mm bucket)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, metric, period])
  @@map("usage_records")
}

// Idempotency ledger for inbound provider webhooks. Paystack retries
// deliver the identical body (and therefore identical HMAC signature), so
// the signature is a perfect per-delivery key: insert-on-receipt, and a
// unique-constraint violation means "already processed — skip".
model WebhookEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider  String // "paystack"
  signature String   @unique // HMAC of the raw body
  eventType String   @map("event_type")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("webhook_events")
}

// ─────────────────────────────────────────────────────────────
// Channels (schema early; used from Phase 4)
// ─────────────────────────────────────────────────────────────

model ChannelIntegration {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String            @map("org_id") @db.Uuid
  channel     Channel
  status      IntegrationStatus @default(PENDING)
  // Encrypted credential blob — never plaintext secrets.
  credentials String?
  metadata    Json              @default("{}")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, channel])
  @@map("channel_integrations")
}

// ─────────────────────────────────────────────────────────────
// Admin console
// ─────────────────────────────────────────────────────────────

enum AdminRoleName {
  SUPER_ADMIN
  OPERATIONS
  SUPPORT
  DEVELOPER
  FINANCE
  MODERATOR
  READ_ONLY
}

model AdminRole {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        AdminRoleName  @unique
  description String?
  isSystem    Boolean        @default(false) @map("is_system")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz

  users      AdminUser[]
  permissions AdminRolePermission[]

  @@map("admin_roles")
}

model AdminPermission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module      String // e.g. "merchants", "ai_agents", "billing"
  action      String // e.g. "read", "write", "delete", "impersonate"
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  roles AdminRolePermission[]

  @@unique([module, action])
  @@map("admin_permissions")
}

model AdminRolePermission {
  roleId       String           @map("role_id") @db.Uuid
  permissionId String           @map("permission_id") @db.Uuid
  grantedAt    DateTime         @default(now()) @map("granted_at") @db.Timestamptz

  role       AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("admin_role_permissions")
}

model AdminUser {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String        @unique
  passwordHash  String        @map("password_hash")
  name          String
  roleId        String?       @map("role_id") @db.Uuid
  avatarUrl     String?       @map("avatar_url")
  emailVerified Boolean       @default(false) @map("email_verified")
  isActive      Boolean       @default(true) @map("is_active")
  lastLoginAt   DateTime?     @map("last_login_at") @db.Timestamptz
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  role            AdminRole?         @relation(fields: [roleId], references: [id], onDelete: SetNull)
  sessions        AdminSession[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  assignedTickets SupportTicket[]    @relation("AssignedTickets")
  createdTickets  SupportTicket[]    @relation("CreatedTickets")
  supportMessages SupportMessage[]

  @@map("admin_users")
}

model AdminSession {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admin_sessions")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId     String?  @map("admin_id") @db.Uuid
  action      String // e.g. "merchant.suspend", "merchant.delete", "admin.login"
  resource    String // e.g. "merchant", "organization", "admin_user"
  resourceId  String?  @map("resource_id") @db.Uuid
  metadata    Json     @default("{}")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  admin AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([action])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model FeatureFlag {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  label       String
  description String?
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("feature_flags")
}

model PasswordResetToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([email, expiresAt])
  @@map("password_reset_tokens")
}

model SystemEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      String // "info", "warning", "error", "critical"
  source    String // "system", "ai", "billing", "auth"
  title     String
  message   String?
  metadata  Json     @default("{}")
  acknowledged Boolean @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([type])
  @@index([createdAt])
  @@map("system_events")
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId   String   @map("admin_id") @db.Uuid
  type      String // "info", "warning", "alert", "success"
  title     String
  message   String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, read])
  @@index([createdAt])
  @@map("notifications")
}

model SupportTicket {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  subject     String
  status      String   @default("open") // "open", "in_progress", "resolved", "closed"
  priority    String   @default("normal") // "low", "normal", "high", "critical"
  assignedTo  String?  @map("assigned_to") @db.Uuid
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignee AdminUser?   @relation("AssignedTickets", fields: [assignedTo], references: [id], onDelete: SetNull)
  creator  AdminUser?   @relation("CreatedTickets", fields: [createdBy], references: [id], onDelete: SetNull)
  messages SupportMessage[]

  @@index([orgId])
  @@index([assignedTo])
  @@index([status])
  @@map("support_tickets")
}

model SupportMessage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  adminId    String?  @map("admin_id") @db.Uuid
  authorName String   @map("author_name")
  content    String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  ticket  SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  admin   AdminUser?    @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

// ─────────────────────────────────────────────────────────────
// Brand Theme & Customization
// ─────────────────────────────────────────────────────────────

enum ThemeMode {
  LIGHT
  DARK
  AUTO
}

enum BorderRadiusStyle {
  SQUARE
  SLIGHTLY_ROUNDED
  ROUNDED
  PILL
}

enum LauncherStyle {
  CIRCLE
  ROUNDED
  SQUARE
  GLASS
  MINIMAL
}

enum WidgetPosition {
  BOTTOM_RIGHT
  BOTTOM_LEFT
}

enum WidgetAnimation {
  FADE
  SLIDE
  BOUNCE
  NONE
}

model BrandTheme {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  websiteId         String            @unique @map("website_id") @db.Uuid
  orgId             String            @map("org_id") @db.Uuid

  // Detected branding (auto-populated by crawler)
  logoUrl           String?           @map("logo_url")
  faviconUrl        String?           @map("favicon_url")
  primaryColor      String?           @map("primary_color")
  secondaryColor    String?           @map("secondary_color")
  accentColor       String?           @map("accent_color")
  backgroundColor   String?           @map("background_color")
  fontFamily        String?           @map("font_family")
  borderRadius      String?           @map("border_radius")
  borderRadiusStyle BorderRadiusStyle? @map("border_radius_style")
  buttonStyle       Json?             @map("button_style")
  themeMode         ThemeMode         @default(AUTO) @map("theme_mode")

  // Generated widget theme (Phase 2 output)
  widgetTheme       Json              @default("{}") @map("widget_theme")

  // Merchant overrides (Phase 3 — manual edits)
  overrides         Json              @default("{}")
  isAutoDetected    Boolean           @default(true) @map("is_auto_detected")

  // Widget appearance settings
  businessName      String?           @map("business_name")
  assistantName     String?           @map("assistant_name")
  launcherStyle     LauncherStyle     @default(CIRCLE) @map("launcher_style")
  widgetPosition    WidgetPosition    @default(BOTTOM_RIGHT) @map("widget_position")
  animation         WidgetAnimation   @default(FADE)
  launcherSize      Int               @default(56) @map("launcher_size")
  headerHeight      Int               @default(64) @map("header_height")

  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  website           WebsiteRegistry   @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("brand_themes")
}

// ─────────────────────────────────────────────────────────────
// Milestone C — Commerce Actions & Conversion Engine
// ─────────────────────────────────────────────────────────────

enum CartStatus {
  ACTIVE
  CHECKOUT_STARTED
  COMPLETED
  ABANDONED
  EXPIRED
}

enum AttributionType {
  DIRECT
  ASSISTED
}

model Cart {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String      @map("org_id") @db.Uuid
  sessionId       String      @map("session_id")
  customerId      String?     @map("customer_id") @db.Uuid
  conversationId  String?     @map("conversation_id") @db.Uuid
  externalCartId  String?     @map("external_cart_id")
  status          CartStatus  @default(ACTIVE)
  currency        String      @default("NGN")
  totalAmount     Decimal     @default(0) @db.Decimal(12, 2)
  metadata        Json        @default("{}")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  org              Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversation     Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  items            CartItem[]
  abandonedCart    AbandonedCart?
  attributedOrders AttributedOrder[]

  @@index([orgId, sessionId])
  @@index([orgId, status])
  @@map("carts")
}

model CartItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId      String   @map("cart_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  variantId   String?  @map("variant_id") @db.Uuid
  productName String   @map("product_name")
  quantity    Int      @default(1)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalPrice  Decimal  @map("total_price") @db.Decimal(12, 2)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([cartId])
  @@map("cart_items")
}

model AttributedOrder {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String          @map("org_id") @db.Uuid
  orderId         String          @map("order_id")
  cartId          String?         @map("cart_id") @db.Uuid
  customerId      String?         @map("customer_id") @db.Uuid
  conversationId  String?         @map("conversation_id") @db.Uuid
  attributionType AttributionType @default(DIRECT) @map("attribution_type")
  amount          Decimal         @db.Decimal(12, 2)
  currency        String          @default("NGN")
  items           Json            @default("[]")
  metadata        Json            @default("{}")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  cart         Cart?         @relation(fields: [cartId], references: [id], onDelete: SetNull)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@unique([orgId, orderId])
  @@index([orgId, attributionType, createdAt])
  @@map("attributed_orders")
}

model AbandonedCart {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  cartId         String    @unique @map("cart_id") @db.Uuid
  customerId     String?   @map("customer_id") @db.Uuid
  conversationId String?   @map("conversation_id") @db.Uuid
  sessionId      String    @map("session_id")
  cartValue      Decimal   @map("cart_value") @db.Decimal(12, 2)
  itemCount      Int       @map("item_count")
  lastActivityAt DateTime  @map("last_activity_at") @db.Timestamptz
  recoveredAt    DateTime? @map("recovered_at") @db.Timestamptz
  status         String    @default("ABANDONED")
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  cart         Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([orgId, status, lastActivityAt])
  @@map("abandoned_carts")
}

// ─────────────────────────────────────────────────────────────
// Milestone E — Learning Engine & Adaptive Commerce
// ─────────────────────────────────────────────────────────────

model ProductPerformanceMetric {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  impressions    Int      @default(0)
  clicks         Int      @default(0)
  carts          Int      @default(0)
  purchases      Int      @default(0)
  returns        Int      @default(0)
  ctr            Float    @default(0)
  cartRate       Float    @default(0) @map("cart_rate")
  conversionRate Float    @default(0) @map("conversion_rate")
  returnRate     Float    @default(0) @map("return_rate")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([orgId, productId])
  @@index([orgId, conversionRate])
  @@map("product_performance_metrics")
}

model IntentProductPerformance {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  intentKey      String   @map("intent_key")
  productId      String   @map("product_id") @db.Uuid
  impressions    Int      @default(0)
  clicks         Int      @default(0)
  purchases      Int      @default(0)
  conversionRate Float    @default(0) @map("conversion_rate")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([orgId, intentKey, productId])
  @@index([orgId, intentKey])
  @@map("intent_product_performances")
}

model ConversationSignal {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  topic          String
  stage          String   @default("DISCOVERY")
  sessionCount   Int      @default(0) @map("session_count")
  purchaseCount  Int      @default(0) @map("purchase_count")
  conversionRate Float    @default(0) @map("conversion_rate")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, topic, stage])
  @@map("conversation_signals")
}

model Experiment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  name        String
  key         String
  description String?
  status      String   @default("DRAFT") // "DRAFT", "RUNNING", "PAUSED", "COMPLETED"
  variants    Json     @default("[]")
  metrics     Json     @default("{}")
  startedAt   DateTime? @map("started_at") @db.Timestamptz
  endedAt     DateTime? @map("ended_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignments ExperimentAssignment[]

  @@unique([orgId, key])
  @@index([orgId, status])
  @@map("experiments")
}

model ExperimentAssignment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  experimentId String   @map("experiment_id") @db.Uuid
  sessionId    String   @map("session_id")
  variantId    String   @map("variant_id")
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  experiment Experiment   @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@unique([experimentId, sessionId])
  @@index([orgId, experimentId])
  @@map("experiment_assignments")
}

model RankingModel {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId               String    @map("org_id") @db.Uuid
  version             String
  status              String    @default("CANDIDATE") // "CANDIDATE", "PRODUCTION", "ARCHIVED", "ROLLED_BACK"
  weights             Json      @default("{}")
  metrics             Json      @default("{}")
  trainingWindowStart DateTime? @map("training_window_start") @db.Timestamptz
  trainingWindowEnd   DateTime? @map("training_window_end") @db.Timestamptz
  promotedAt          DateTime? @map("promoted_at") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, version])
  @@index([orgId, status])
  @@map("ranking_models")
}


