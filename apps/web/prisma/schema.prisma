generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  ADMIN
  AGENT
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum ProductSource {
  MANUAL
  CRAWL
  IMPORT
}

enum KnowledgeType {
  FAQ
  POLICY
  DOCUMENT
}

enum EmbeddingSourceType {
  PRODUCT
  KNOWLEDGE_ENTRY
}

enum BuyingStage {
  EXPLORING
  COMPARING
  PURCHASE_READY
  PURCHASED
}

enum Channel {
  WEBSITE
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  EMAIL
}

enum ConversationStatus {
  ACTIVE
  ENDED
  HANDED_OFF
}

enum ConversationOutcome {
  PENDING
  PURCHASED
  RESOLVED
  ABANDONED
}

enum MessageRole {
  CUSTOMER
  AI
  SYSTEM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum IntegrationStatus {
  PENDING
  CONNECTED
  ERROR
  DISABLED
}

// ─────────────────────────────────────────────────────────────
// Tenancy & identity
// ─────────────────────────────────────────────────────────────

model Organization {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkOrgId String?  @unique @map("clerk_org_id")
  name       String
  slug       String   @unique
  websiteUrl String?  @map("website_url")
  industry   String?
  country    String   @default("Nigeria")
  currency   String   @default("NGN")
  logoUrl    String?  @map("logo_url")
  settings   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  users               User[]
  categories          Category[]
  products            Product[]
  knowledgeEntries    KnowledgeEntry[]
  embeddings          Embedding[]
  customers           Customer[]
  conversations       Conversation[]
  customerEvents      CustomerEvent[]
  widgetKeys          WidgetKey[]
  subscription        Subscription?
  usageRecords        UsageRecord[]
  channelIntegrations ChannelIntegration[]

  @@map("organizations")
}

model User {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId String        @unique @map("clerk_user_id")
  orgId       String?       @map("org_id") @db.Uuid
  email       String        @unique
  name        String
  role        UserRole      @default(AGENT)
  avatarUrl   String?       @map("avatar_url")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  org         Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("users")
}

model WidgetKey {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  publicKey      String   @unique @map("public_key")
  label          String   @default("Default")
  allowedDomains String[] @default([]) @map("allowed_domains")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("widget_keys")
}

// ─────────────────────────────────────────────────────────────
// Catalog & knowledge
// ─────────────────────────────────────────────────────────────

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  parentId  String?  @map("parent_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent   Category?    @relation("SubCategories", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]   @relation("SubCategories")
  products Product[]

  @@unique([orgId, name])
  @@map("categories")
}

model Product {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String          @map("org_id") @db.Uuid
  categoryId      String?         @map("category_id") @db.Uuid
  name            String
  description     String?
  price           Decimal         @db.Decimal(12, 2)
  currency        String          @default("NGN")
  images          Json            @default("[]")
  attributes      Json            @default("{}")
  inventoryStatus InventoryStatus @default(IN_STOCK) @map("inventory_status")
  source          ProductSource   @default(MANUAL)
  sourceUrl       String?         @map("source_url")
  aiDescription   String?         @map("ai_description")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([orgId, categoryId])
  @@map("products")
}

model KnowledgeEntry {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String        @map("org_id") @db.Uuid
  type      KnowledgeType
  title     String
  content   String
  metadata  Json          @default("{}")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, type])
  @@map("knowledge_entries")
}

model Embedding {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String              @map("org_id") @db.Uuid
  sourceType EmbeddingSourceType @map("source_type")
  sourceId   String              @map("source_id") @db.Uuid
  chunkIndex Int                 @default(0) @map("chunk_index")
  chunkText  String              @map("chunk_text")
  // Dimension matches Voyage AI voyage-3-large default output (1024).
  embedding  Unsupported("vector(1024)")?
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId, chunkIndex])
  @@index([orgId, sourceType])
  @@map("embeddings")
}

// ─────────────────────────────────────────────────────────────
// Customers & conversations
// ─────────────────────────────────────────────────────────────

model Customer {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String      @map("org_id") @db.Uuid
  externalId  String?     @map("external_id")
  name        String?
  email       String?
  phone       String?
  preferences Json        @default("[]")
  buyingStage BuyingStage @default(EXPLORING) @map("buying_stage")
  firstSeen   DateTime    @default(now()) @map("first_seen") @db.Timestamptz
  lastSeen    DateTime    @default(now()) @map("last_seen") @db.Timestamptz

  org            Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversations  Conversation[]
  customerEvents CustomerEvent[]

  @@unique([orgId, externalId])
  @@index([orgId, lastSeen])
  @@map("customers")
}

model Conversation {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String              @map("org_id") @db.Uuid
  customerId   String              @map("customer_id") @db.Uuid
  channel      Channel             @default(WEBSITE)
  status       ConversationStatus  @default(ACTIVE)
  startedAt    DateTime            @default(now()) @map("started_at") @db.Timestamptz
  endedAt      DateTime?           @map("ended_at") @db.Timestamptz
  summary      String?
  intent       String              @default("greeting")
  aiConfidence Int                 @default(100) @map("ai_confidence")
  outcome      ConversationOutcome @default(PENDING)

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([orgId, startedAt])
  @@index([customerId])
  @@map("conversations")
}

model Message {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId  String      @map("conversation_id") @db.Uuid
  role            MessageRole
  content         String
  intent          String?
  recommendations Json        @default("[]")
  inputTokens     Int         @default(0) @map("input_tokens")
  outputTokens    Int         @default(0) @map("output_tokens")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model CustomerEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  eventType  String   @map("event_type")
  pageUrl    String?  @map("page_url")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([customerId, createdAt])
  @@map("customer_events")
}

// ─────────────────────────────────────────────────────────────
// Billing & usage
// ─────────────────────────────────────────────────────────────

model Plan {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String  @unique // "starter" | "growth" | "pro"
  name              String
  priceMonthly      Decimal @map("price_monthly") @db.Decimal(12, 2)
  currency          String  @default("NGN")
  paystackPlanCode  String? @map("paystack_plan_code")
  monthlyMessageCap Int     @map("monthly_message_cap")
  productCap        Int     @map("product_cap")
  channelCap        Int     @default(1) @map("channel_cap")
  active            Boolean @default(true)

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                    String             @unique @map("org_id") @db.Uuid
  planId                   String             @map("plan_id") @db.Uuid
  status                   SubscriptionStatus @default(TRIALING)
  paystackCustomerCode     String?            @map("paystack_customer_code")
  paystackSubscriptionCode String?            @map("paystack_subscription_code")
  trialEndsAt              DateTime?          @map("trial_ends_at") @db.Timestamptz
  currentPeriodEnd         DateTime?          @map("current_period_end") @db.Timestamptz
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan Plan         @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model UsageRecord {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId    String   @map("org_id") @db.Uuid
  metric   String // "ai_messages" | "embedding_tokens" | ...
  quantity Int
  period   String // "2026-07" (yyyy-mm bucket)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, metric, period])
  @@map("usage_records")
}

// ─────────────────────────────────────────────────────────────
// Channels (schema early; used from Phase 4)
// ─────────────────────────────────────────────────────────────

model ChannelIntegration {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String            @map("org_id") @db.Uuid
  channel     Channel
  status      IntegrationStatus @default(PENDING)
  // Encrypted credential blob — never plaintext secrets.
  credentials String?
  metadata    Json              @default("{}")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, channel])
  @@map("channel_integrations")
}
