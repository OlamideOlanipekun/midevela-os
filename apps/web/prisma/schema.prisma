generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  ADMIN
  AGENT
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum ProductSource {
  MANUAL
  CRAWL
  IMPORT
}

enum KnowledgeType {
  FAQ
  POLICY
  DOCUMENT
}

enum EmbeddingSourceType {
  PRODUCT
  KNOWLEDGE_ENTRY
}

enum BuyingStage {
  EXPLORING
  COMPARING
  PURCHASE_READY
  PURCHASED
}

enum Channel {
  WEBSITE
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  EMAIL
}

enum ConversationStatus {
  ACTIVE
  ENDED
  HANDED_OFF
}

enum ConversationOutcome {
  PENDING
  PURCHASED
  RESOLVED
  ABANDONED
}

enum MessageRole {
  CUSTOMER
  AI
  SYSTEM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum IntegrationStatus {
  PENDING
  CONNECTED
  ERROR
  DISABLED
}

// ─────────────────────────────────────────────────────────────
// Tenancy & identity
// ─────────────────────────────────────────────────────────────

model Organization {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  slug       String   @unique
  websiteUrl String?  @map("website_url")
  industry   String?
  country    String   @default("Nigeria")
  currency   String   @default("NGN")
  logoUrl    String?  @map("logo_url")
  settings   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  users               User[]
  categories          Category[]
  products            Product[]
  knowledgeEntries    KnowledgeEntry[]
  embeddings          Embedding[]
  customers           Customer[]
  conversations       Conversation[]
  customerEvents      CustomerEvent[]
  widgetKeys          WidgetKey[]
  subscription        Subscription?
  usageRecords        UsageRecord[]
  channelIntegrations ChannelIntegration[]
  supportTickets      SupportTicket[]

  @@map("organizations")
}

model User {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String?       @map("org_id") @db.Uuid
  email         String        @unique
  passwordHash  String        @map("password_hash")
  name          String
  role          UserRole      @default(AGENT)
  avatarUrl     String?       @map("avatar_url")
  emailVerified Boolean       @default(false) @map("email_verified")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  org           Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sessions      Session[]

  @@index([orgId])
  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  // SHA-256 of the random session token — never store the raw token.
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model WidgetKey {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  publicKey      String   @unique @map("public_key")
  label          String   @default("Default")
  allowedDomains String[] @default([]) @map("allowed_domains")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("widget_keys")
}

// ─────────────────────────────────────────────────────────────
// Catalog & knowledge
// ─────────────────────────────────────────────────────────────

model Category {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId             String   @map("org_id") @db.Uuid
  name              String
  slug              String?
  image             String?
  icon              String?
  displayOrder      Int      @default(0) @map("display_order")
  // Ordered qualification steps the widget walks for this category, e.g.
  // [{ id, key, question, type: "single"|"budget", options:[{label,value,icon?}] }].
  // Never hardcoded in the widget — see server/widget/qualificationTemplates.ts.
  qualificationFlow Json     @default("[]") @map("qualification_flow")
  parentId          String?  @map("parent_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent   Category?    @relation("SubCategories", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]   @relation("SubCategories")
  products Product[]

  @@unique([orgId, name])
  @@map("categories")
}

model Product {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String          @map("org_id") @db.Uuid
  categoryId      String?         @map("category_id") @db.Uuid
  name            String
  brand           String?
  description     String?
  price           Decimal         @db.Decimal(12, 2)
  currency        String          @default("NGN")
  images          Json            @default("[]")
  attributes      Json            @default("{}")
  inventoryStatus InventoryStatus @default(IN_STOCK) @map("inventory_status")
  source          ProductSource   @default(MANUAL)
  sourceUrl       String?         @map("source_url")
  aiDescription   String?         @map("ai_description")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([orgId, categoryId])
  @@index([orgId, brand])
  @@map("products")
}

model KnowledgeEntry {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String        @map("org_id") @db.Uuid
  type      KnowledgeType
  title     String
  content   String
  metadata  Json          @default("{}")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, type])
  @@map("knowledge_entries")
}

model Embedding {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String              @map("org_id") @db.Uuid
  sourceType EmbeddingSourceType @map("source_type")
  sourceId   String              @map("source_id") @db.Uuid
  chunkIndex Int                 @default(0) @map("chunk_index")
  chunkText  String              @map("chunk_text")
  // Dimension matches Voyage AI voyage-3-large default output (1024).
  embedding  Unsupported("vector(1024)")?
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId, chunkIndex])
  @@index([orgId, sourceType])
  @@map("embeddings")
}

// ─────────────────────────────────────────────────────────────
// Customers & conversations
// ─────────────────────────────────────────────────────────────

model Customer {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String      @map("org_id") @db.Uuid
  externalId  String?     @map("external_id")
  name        String?
  email       String?
  phone       String?
  preferences Json        @default("[]")
  buyingStage BuyingStage @default(EXPLORING) @map("buying_stage")
  firstSeen   DateTime    @default(now()) @map("first_seen") @db.Timestamptz
  lastSeen    DateTime    @default(now()) @map("last_seen") @db.Timestamptz

  org            Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversations  Conversation[]
  customerEvents CustomerEvent[]

  @@unique([orgId, externalId])
  @@index([orgId, lastSeen])
  @@map("customers")
}

model Conversation {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String              @map("org_id") @db.Uuid
  customerId   String              @map("customer_id") @db.Uuid
  channel      Channel             @default(WEBSITE)
  status       ConversationStatus  @default(ACTIVE)
  startedAt    DateTime            @default(now()) @map("started_at") @db.Timestamptz
  endedAt      DateTime?           @map("ended_at") @db.Timestamptz
  summary      String?
  intent       String              @default("greeting")
  aiConfidence Int                 @default(100) @map("ai_confidence")
  outcome      ConversationOutcome @default(PENDING)
  // Shopping-funnel state: { categoryId, categoryName, budget:{min,max},
  // brand, answers:{}, viewedProductIds:[], funnelStep }. Grounds AI chat
  // turns and lets a returning visitor resume without repeating themselves.
  context      Json                @default("{}")

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([orgId, startedAt])
  @@index([customerId])
  @@map("conversations")
}

model Message {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId  String      @map("conversation_id") @db.Uuid
  role            MessageRole
  content         String
  intent          String?
  recommendations Json        @default("[]")
  inputTokens     Int         @default(0) @map("input_tokens")
  outputTokens    Int         @default(0) @map("output_tokens")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model CustomerEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  eventType  String   @map("event_type")
  pageUrl    String?  @map("page_url")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([customerId, createdAt])
  @@map("customer_events")
}

// ─────────────────────────────────────────────────────────────
// Billing & usage
// ─────────────────────────────────────────────────────────────

model Plan {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String  @unique // "starter" | "growth" | "pro"
  name              String
  priceMonthly      Decimal @map("price_monthly") @db.Decimal(12, 2)
  currency          String  @default("NGN")
  paystackPlanCode  String? @map("paystack_plan_code")
  monthlyMessageCap Int     @map("monthly_message_cap")
  productCap        Int     @map("product_cap")
  channelCap        Int     @default(1) @map("channel_cap")
  knowledgeCap      Int     @default(10) @map("knowledge_cap")
  active            Boolean @default(true)

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                    String             @unique @map("org_id") @db.Uuid
  planId                   String             @map("plan_id") @db.Uuid
  status                   SubscriptionStatus @default(TRIALING)
  paystackCustomerCode     String?            @map("paystack_customer_code")
  paystackSubscriptionCode String?            @map("paystack_subscription_code")
  trialEndsAt              DateTime?          @map("trial_ends_at") @db.Timestamptz
  currentPeriodEnd         DateTime?          @map("current_period_end") @db.Timestamptz
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan Plan         @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model UsageRecord {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId    String   @map("org_id") @db.Uuid
  metric   String // "ai_messages" | "embedding_tokens" | ...
  quantity Int
  period   String // "2026-07" (yyyy-mm bucket)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, metric, period])
  @@map("usage_records")
}

// Idempotency ledger for inbound provider webhooks. Paystack retries
// deliver the identical body (and therefore identical HMAC signature), so
// the signature is a perfect per-delivery key: insert-on-receipt, and a
// unique-constraint violation means "already processed — skip".
model WebhookEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider  String // "paystack"
  signature String   @unique // HMAC of the raw body
  eventType String   @map("event_type")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("webhook_events")
}

// ─────────────────────────────────────────────────────────────
// Channels (schema early; used from Phase 4)
// ─────────────────────────────────────────────────────────────

model ChannelIntegration {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String            @map("org_id") @db.Uuid
  channel     Channel
  status      IntegrationStatus @default(PENDING)
  // Encrypted credential blob — never plaintext secrets.
  credentials String?
  metadata    Json              @default("{}")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, channel])
  @@map("channel_integrations")
}

// ─────────────────────────────────────────────────────────────
// Admin console
// ─────────────────────────────────────────────────────────────

enum AdminRoleName {
  SUPER_ADMIN
  OPERATIONS
  SUPPORT
  DEVELOPER
  FINANCE
  MODERATOR
  READ_ONLY
}

model AdminRole {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        AdminRoleName  @unique
  description String?
  isSystem    Boolean        @default(false) @map("is_system")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz

  users      AdminUser[]
  permissions AdminRolePermission[]

  @@map("admin_roles")
}

model AdminPermission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module      String // e.g. "merchants", "ai_agents", "billing"
  action      String // e.g. "read", "write", "delete", "impersonate"
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  roles AdminRolePermission[]

  @@unique([module, action])
  @@map("admin_permissions")
}

model AdminRolePermission {
  roleId       String           @map("role_id") @db.Uuid
  permissionId String           @map("permission_id") @db.Uuid
  grantedAt    DateTime         @default(now()) @map("granted_at") @db.Timestamptz

  role       AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("admin_role_permissions")
}

model AdminUser {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String        @unique
  passwordHash  String        @map("password_hash")
  name          String
  roleId        String?       @map("role_id") @db.Uuid
  avatarUrl     String?       @map("avatar_url")
  emailVerified Boolean       @default(false) @map("email_verified")
  isActive      Boolean       @default(true) @map("is_active")
  lastLoginAt   DateTime?     @map("last_login_at") @db.Timestamptz
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  role            AdminRole?         @relation(fields: [roleId], references: [id], onDelete: SetNull)
  sessions        AdminSession[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  assignedTickets SupportTicket[]    @relation("AssignedTickets")
  createdTickets  SupportTicket[]    @relation("CreatedTickets")
  supportMessages SupportMessage[]

  @@map("admin_users")
}

model AdminSession {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admin_sessions")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId     String?  @map("admin_id") @db.Uuid
  action      String // e.g. "merchant.suspend", "merchant.delete", "admin.login"
  resource    String // e.g. "merchant", "organization", "admin_user"
  resourceId  String?  @map("resource_id") @db.Uuid
  metadata    Json     @default("{}")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  admin AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([action])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model FeatureFlag {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  label       String
  description String?
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("feature_flags")
}

model SystemEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      String // "info", "warning", "error", "critical"
  source    String // "system", "ai", "billing", "auth"
  title     String
  message   String?
  metadata  Json     @default("{}")
  acknowledged Boolean @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([type])
  @@index([createdAt])
  @@map("system_events")
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId   String   @map("admin_id") @db.Uuid
  type      String // "info", "warning", "alert", "success"
  title     String
  message   String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, read])
  @@index([createdAt])
  @@map("notifications")
}

model SupportTicket {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  subject     String
  status      String   @default("open") // "open", "in_progress", "resolved", "closed"
  priority    String   @default("normal") // "low", "normal", "high", "critical"
  assignedTo  String?  @map("assigned_to") @db.Uuid
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignee AdminUser?   @relation("AssignedTickets", fields: [assignedTo], references: [id], onDelete: SetNull)
  creator  AdminUser?   @relation("CreatedTickets", fields: [createdBy], references: [id], onDelete: SetNull)
  messages SupportMessage[]

  @@index([orgId])
  @@index([assignedTo])
  @@index([status])
  @@map("support_tickets")
}

model SupportMessage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  adminId    String?  @map("admin_id") @db.Uuid
  authorName String   @map("author_name")
  content    String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  ticket  SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  admin   AdminUser?    @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}
