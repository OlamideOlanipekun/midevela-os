 # ── Database (Phase 0) ──────────────────────────────────────────
# Neon or Supabase Postgres with the pgvector extension enabled.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ── Auth (Phase 0) ──────────────────────────────────────────────
# Self-built email/password auth (no third-party provider). Sessions
# are DB-backed (see prisma schema `Session` model) with an httpOnly
# cookie — no auth-specific env vars required.

# ── AI (Phase 1) ────────────────────────────────────────────────
# MVP LLM provider — console.groq.com
GROQ_API_KEY="gsk_..."
# Embeddings — voyageai.com
VOYAGE_API_KEY="pa-..."

# ── Rate limiting (Phase 1) ─────────────────────────────────────
# Upstash Redis (REST) — console.upstash.com. Protects the public
# widget endpoint (paid LLM calls) and auth routes (brute force). If
# unset, the limiter fails OPEN (allows traffic) so a missing/broken
# Redis never takes the app down.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Optional hard monthly ceiling on widget LLM calls per org (abuse
# backstop, independent of plan caps). Defaults to 10000 if unset.
WIDGET_MONTHLY_CAP=""

# ── Alerting / observability (Phase 1) ──────────────────────────
# Optional. A webhook URL (Slack incoming webhook, Discord, or any JSON
# receiver) that gets POSTed on critical failures — a Paystack webhook
# that couldn't activate a paid subscription, or an unhandled 500. If
# unset, alerts still land as structured [ALERT] lines in the logs.
ALERT_WEBHOOK_URL=""

# ── Billing ──────────────────────────────────────────────────────
# dashboard.paystack.com → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY="sk_test_..."
PAYSTACK_PUBLIC_KEY="pk_test_..."
# Registered in the same dashboard page once this endpoint is deployed.
PAYSTACK_WEBHOOK_URL="https://your-domain/api/webhooks/paystack"

# ── Catalog crawling (Phase 2) ──────────────────────────────────
# Optional. firecrawl.dev — hosted browser crawl for JS-rendered stores.
# The catalog importer works without it (platform-JSON → JSON-LD →
# fetch+LLM); Firecrawl is the last-resort layer for JS-heavy/bot-
# protected sites and only runs when the free layers find nothing.
FIRECRAWL_API_KEY=""
