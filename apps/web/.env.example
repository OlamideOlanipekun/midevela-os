 # ── Database (Phase 0) ──────────────────────────────────────────
# Neon or Supabase Postgres with the pgvector extension enabled.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ── Auth (Phase 0) ──────────────────────────────────────────────
# Self-built email/password auth (no third-party provider). Sessions
# are DB-backed (see prisma schema `Session` model) with an httpOnly
# cookie — no auth-specific env vars required.

# ── AI (Phase 1) ────────────────────────────────────────────────
# MVP LLM provider — console.groq.com
GROQ_API_KEY="gsk_..."
# Embeddings — voyageai.com
VOYAGE_API_KEY="pa-..."

# ── Rate limiting (Phase 1) ─────────────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Billing ──────────────────────────────────────────────────────
# dashboard.paystack.com → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY="sk_test_..."
PAYSTACK_PUBLIC_KEY="pk_test_..."
# Registered in the same dashboard page once this endpoint is deployed.
PAYSTACK_WEBHOOK_URL="https://your-domain/api/webhooks/paystack"
