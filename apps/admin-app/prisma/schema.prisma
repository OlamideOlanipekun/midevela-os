generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──

enum AdminRoleName {
  SUPER_ADMIN
  OPERATIONS
  SUPPORT
  DEVELOPER
  FINANCE
  MODERATOR
  READ_ONLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum ConversationStatus {
  ACTIVE
  ENDED
  HANDED_OFF
}

enum WebsiteStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum ConversationOutcome {
  PENDING
  PURCHASED
  RESOLVED
  ABANDONED
}

enum MessageRole {
  CUSTOMER
  AI
  SYSTEM
}

enum AlertSeverity {
  CRITICAL
  WARNING
  INFO
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  ESCALATED
}

enum CrawlJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum WebsiteCrawlStatus {
  NOT_STARTED
  CRAWLING
  INDEXING
  READY
  FAILED
}

// ── Admin auth models ──

model Admin {
  id           String   @id @default(uuid()) @db.Uuid
  firstName    String   @map("first_name")
  lastName     String?  @map("last_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  avatar       String?
  isActive     Boolean  @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  roles         AdminAdminRole[]
  sessions      AdminSession[]
  auditLogs     AuditLog[]
  merchantNotes MerchantNote[]
  notifications Notification[]
  alertPreferences NotificationPreference[]
  securityEvents SecurityEvent[]
  complianceExports ComplianceExport[]
  assignedTickets   SupportTicket[]   @relation("AssignedTickets")
  createdTickets    SupportTicket[]   @relation("CreatedTickets")
  supportMessages   SupportMessage[]

  @@map("admins")
}

model AdminRole {
  id          String        @id @default(uuid()) @db.Uuid
  name        AdminRoleName @unique
  description String?
  isSystem    Boolean       @default(false) @map("is_system")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  admins      AdminAdminRole[]
  permissions AdminRolePermission[]

  @@map("admin_roles")
}

model AdminPermission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  roles AdminRolePermission[]

  @@map("admin_permissions")
}

model AdminAdminRole {
  adminId   String   @map("admin_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz

  admin Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  role  AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminId, roleId])
  @@map("admin_admin_roles")
}

model AdminRolePermission {
  roleId       String         @map("role_id") @db.Uuid
  permissionId String         @map("permission_id") @db.Uuid
  grantedAt    DateTime       @default(now()) @map("granted_at") @db.Timestamptz

  role       AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("admin_role_permissions")
}

model AdminSession {
  id               String   @id @default(uuid()) @db.Uuid
  adminId          String   @map("admin_id") @db.Uuid
  refreshTokenHash String   @unique @map("refresh_token_hash")
  ipAddress        String?  @map("ip_address")
  device           String?  @map("device")
  browser          String?  @map("browser")
  expiresAt        DateTime @map("expires_at") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_sessions")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  adminId   String?  @map("admin_id") @db.Uuid
  action    String
  module    String
  targetId  String?  @map("target_id") @db.Uuid
  metadata  Json     @default("{}")
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([action])
  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}

// ── Dashboard data models (read-only views into shared DB) ──

model Organization {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  slug       String   @unique
  websiteUrl String?  @map("website_url")
  industry   String?
  country    String   @default("Nigeria")
  currency   String   @default("NGN")
  logoUrl    String?  @map("logo_url")
  settings   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  subscription    Subscription?
  conversations   Conversation[]
  products        Product[]
  websites        WebsiteRegistry[]
  knowledgeEntries KnowledgeEntry[]
  customers       Customer[]
  merchantNotes   MerchantNote[]
  merchantUsage   MerchantUsage?
  users           User[]
  documents       Document[]
  knowledgeChunks KnowledgeChunk[]
  embeddings      Embedding[]
  missingAnswers  MissingAnswer[]
  productCategories ProductCategory[]
  catalogSyncJobs CatalogSyncJob[]
  catalogHealth   CatalogHealth?
  recommendationLogs RecommendationLog[]
  tokenUsage      TokenUsage[]
  aiCosts         AICost[]
  aiErrors        AIError[]
  analyticsEvents AnalyticsEvent[]
  queueJobs       QueueJob[]
  invoices        Invoice[]
  payments        Payment[]
  refunds         Refund[]
  usageRecords    UsageRecord[]
  billingEvents   BillingEvent[]
  enterpriseAccounts EnterpriseAccount[]
  alerts          Alert[]
  supportTickets  SupportTicket[]

  @@map("organizations")
}

model Subscription {
  id                       String             @id @default(uuid()) @db.Uuid
  orgId                    String             @unique @map("org_id") @db.Uuid
  planId                   String             @map("plan_id") @db.Uuid
  status                   SubscriptionStatus @default(TRIALING)
  trialEndsAt              DateTime?          @map("trial_ends_at") @db.Timestamptz
  currentPeriodEnd         DateTime?          @map("current_period_end") @db.Timestamptz
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan Plan         @relation(fields: [planId], references: [id])
  payments Payment[]
  invoices  Invoice[]

  @@map("subscriptions")
}

model Plan {
  id                String  @id @default(uuid()) @db.Uuid
  code              String  @unique
  name              String
  description       String?
  priceMonthly      Decimal @map("price_monthly") @db.Decimal(12, 2)
  priceYearly       Decimal? @map("price_yearly") @db.Decimal(12, 2)
  currency          String  @default("NGN")
  active            Boolean @default(true)
  sortOrder         Int     @default(0) @map("sort_order")
  features          Json    @default("[]")
  limits            Json    @default("{}")

  subscriptions    Subscription[]
  enterpriseAccounts EnterpriseAccount[]

  @@map("plans")
}

model WebsiteRegistry {
  id                 String           @id @default(uuid()) @db.Uuid
  orgId              String           @map("org_id") @db.Uuid
  domain             String           @map("domain")
  normalizedUrl      String           @unique @map("normalized_url")
  status             WebsiteStatus    @default(ACTIVE)
  verified           Boolean          @default(false)
  verificationToken  String?          @unique @map("verification_token")
  verificationMethod String?          @map("verification_method")
  sslStatus          String           @default("unknown") @map("ssl_status")
  robotsStatus       String           @default("unknown") @map("robots_status")
  healthScore        Int              @default(0) @map("health_score")
  crawlStatus        WebsiteCrawlStatus @default(NOT_STARTED) @map("crawl_status")
  lastCrawledAt      DateTime?        @map("last_crawled_at") @db.Timestamptz
  nextCrawlAt        DateTime?        @map("next_crawl_at") @db.Timestamptz
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  crawlJobs  CrawlJob[]
  healthLogs WebsiteHealth[]

  @@index([orgId])
  @@index([status])
  @@index([crawlStatus])
  @@map("website_registry")
}

model CrawlJob {
  id              String             @id @default(uuid()) @db.Uuid
  websiteId       String             @map("website_id") @db.Uuid
  status          CrawlJobStatus     @default(PENDING)
  pagesFound      Int                @default(0) @map("pages_found")
  productsFound   Int                @default(0) @map("products_found")
  categoriesFound Int                @default(0) @map("categories_found")
  errors          Int                @default(0)
  duration        Int                @default(0)
  startedAt       DateTime?          @map("started_at") @db.Timestamptz
  completedAt     DateTime?          @map("completed_at") @db.Timestamptz
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz

  website WebsiteRegistry @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, createdAt])
  @@index([status])
  @@map("crawl_jobs")
}

model WebsiteHealth {
  id           String   @id @default(uuid()) @db.Uuid
  websiteId    String   @map("website_id") @db.Uuid
  uptime       Int      @default(100)
  ssl          Int      @default(100)
  robots       Int      @default(100)
  responseTime Int      @default(200) @map("response_time")
  pages        Int      @default(0)
  products     Int      @default(0)
  knowledge    Int      @default(0)
  lastChecked  DateTime @default(now()) @map("last_checked") @db.Timestamptz

  website WebsiteRegistry @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, lastChecked])
  @@map("website_health")
}

model KnowledgeEntry {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  title     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("knowledge_entries")
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String?
  email     String?
  firstSeen DateTime @default(now()) @map("first_seen") @db.Timestamptz
  lastSeen  DateTime @default(now()) @map("last_seen") @db.Timestamptz

  org           Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([orgId, lastSeen])
  @@map("customers")
}

model Conversation {
  id           String             @id @default(uuid()) @db.Uuid
  orgId        String             @map("org_id") @db.Uuid
  customerId   String             @map("customer_id") @db.Uuid
  status       ConversationStatus @default(ACTIVE)
  intent       String             @default("greeting")
  aiConfidence Int                @default(100) @map("ai_confidence")
  outcome      ConversationOutcome @default(PENDING)
  qualityScore Int                @default(0) @map("quality_score")
  tags         Json               @default("[]")
  humanJoined  Boolean            @default(false) @map("human_joined")
  aiPaused     Boolean            @default(false) @map("ai_paused")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages Message[]
  events   ConversationEvent[]

  @@index([orgId, createdAt])
  @@index([status])
  @@index([qualityScore])
  @@map("conversations")
}

model ConversationEvent {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  type           String
  data           Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("conversation_events")
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  role           MessageRole
  content        String
  inputTokens    Int      @default(0) @map("input_tokens")
  outputTokens   Int      @default(0) @map("output_tokens")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model SystemEvent {
  id        String   @id @default(uuid()) @db.Uuid
  type      String
  source    String
  title     String
  message   String?
  metadata  Json     @default("{}")
  acknowledged Boolean @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([type])
  @@index([createdAt])
  @@map("system_events")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  email     String   @unique
  name      String?
  role      String   @default("owner")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("users")
}

model MerchantNote {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  adminId   String   @map("admin_id") @db.Uuid
  content   String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  admin Admin?       @relation(fields: [adminId], references: [id], onDelete: Cascade)
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@map("merchant_notes")
}

model MerchantUsage {
  id              String   @id @default(uuid()) @db.Uuid
  orgId           String   @unique @map("org_id") @db.Uuid
  messagesTotal   Int      @default(0) @map("messages_total")
  messagesMonth   Int      @default(0) @map("messages_month")
  productsTotal   Int      @default(0) @map("products_total")
  knowledgeFiles  Int      @default(0) @map("knowledge_files")
  storageBytes    BigInt   @default(0) @map("storage_bytes")
  apiCallsTotal   Int      @default(0) @map("api_calls_total")
  apiCallsMonth   Int      @default(0) @map("api_calls_month")
  embeddingsTotal Int      @default(0) @map("embeddings_total")
  crawlerMinutes  Int      @default(0) @map("crawler_minutes")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("merchant_usage")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  adminId   String   @map("admin_id") @db.Uuid
  type      String
  title     String
  message   String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, read])
  @@index([createdAt])
  @@map("notifications")
}

// ══════════════════════════════════════════════════════════
// Phase 6 — AI Operations
// ══════════════════════════════════════════════════════════

enum PromptStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Prompt {
  id          String       @id @default(uuid()) @db.Uuid
  key         String       @unique
  name        String
  description String?
  category    String       @default("general")
  status      PromptStatus @default(DRAFT)
  currentVersion Int       @default(1) @map("current_version")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  versions    PromptVersion[]
  deployments PromptDeployment[]

  @@map("prompts")
}

model PromptVersion {
  id         String   @id @default(uuid()) @db.Uuid
  promptId   String   @map("prompt_id") @db.Uuid
  version    Int
  content    String
  model      String   @default("gpt-4")
  temperature Float   @default(0.7)
  maxTokens  Int      @default(1024) @map("max_tokens")
  notes      String?
  authorId   String?  @map("author_id") @db.Uuid
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  prompt      Prompt  @relation(fields: [promptId], references: [id], onDelete: Cascade)
  deployments PromptDeployment[]

  @@unique([promptId, version])
  @@index([promptId, createdAt])
  @@map("prompt_versions")
}

model PromptDeployment {
  id        String   @id @default(uuid()) @db.Uuid
  promptId  String   @map("prompt_id") @db.Uuid
  versionId String   @map("version_id") @db.Uuid
  environment String @default("production")
  status    String   @default("active")
  deployedBy String? @map("deployed_by") @db.Uuid
  rollbackFrom String? @map("rollback_from")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  prompt  Prompt        @relation(fields: [promptId], references: [id], onDelete: Cascade)
  version PromptVersion @relation(fields: [versionId], references: [id])

  @@index([promptId, createdAt])
  @@map("prompt_deployments")
}

model ModelRoute {
  id        String   @id @default(uuid()) @db.Uuid
  intent    String   @unique
  model     String   @default("gpt-4")
  fallback  String?  @default("gemini")
  priority  Int      @default(0)
  rules     Json     @default("{}")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("model_routes")
}

model TokenUsage {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String?  @map("org_id") @db.Uuid
  conversationId String? @map("conversation_id") @db.Uuid
  model         String
  inputTokens   Int      @default(0) @map("input_tokens")
  outputTokens  Int      @default(0) @map("output_tokens")
  totalTokens   Int      @default(0) @map("total_tokens")
  feature       String   @default("chat")
  cost          Decimal  @default(0) @db.Decimal(12, 6)
  recordedAt    DateTime @default(now()) @map("recorded_at") @db.Timestamptz

  org Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@index([recordedAt])
  @@index([orgId])
  @@index([model, recordedAt])
  @@map("token_usage")
}

model AICost {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String?  @map("org_id") @db.Uuid
  date      DateTime @map("date") @db.Date
  model     String
  cost      Decimal  @db.Decimal(12, 6)
  tokens    Int      @default(0)
  requests  Int      @default(0)
  feature   String   @default("chat")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  org Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@unique([orgId, date, model, feature])
  @@index([date])
  @@index([orgId, date])
  @@map("ai_costs")
}

model AIError {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String?  @map("org_id") @db.Uuid
  conversationId String? @map("conversation_id") @db.Uuid
  model     String
  type      String
  message   String?
  statusCode Int?    @map("status_code")
  latency   Int?     @default(0)
  inputTokens Int?   @map("input_tokens")
  outputTokens Int?  @map("output_tokens")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  org Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([model, createdAt])
  @@index([type, createdAt])
  @@map("ai_errors")
}

// ══════════════════════════════════════════════════════════
// Phase 7 — Knowledge Engine
// ══════════════════════════════════════════════════════════

enum DocumentStatus {
  PENDING
  PROCESSING
  INDEXED
  FAILED
}

enum ChunkStatus {
  ACTIVE
  ORPHANED
}

model Document {
  id          String         @id @default(uuid()) @db.Uuid
  orgId       String         @map("org_id") @db.Uuid
  title       String
  type        String         @default("pdf")
  url         String?
  fileSize    Int?           @default(0) @map("file_size")
  pageCount   Int?           @default(0) @map("page_count")
  status      DocumentStatus @default(PENDING)
  error       String?
  checksum    String?
  source      String         @default("upload")
  author      String?
  metadata    Json           @default("{}")
  chunkCount  Int            @default(0) @map("chunk_count")
  totalTokens Int            @default(0) @map("total_tokens")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  org    Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@index([orgId, status])
  @@index([orgId, createdAt])
  @@map("documents")
}

model KnowledgeChunk {
  id         String      @id @default(uuid()) @db.Uuid
  documentId String      @map("document_id") @db.Uuid
  orgId      String      @map("org_id") @db.Uuid
  index      Int
  content    String
  tokens     Int         @default(0)
  heading    String?
  pageNumber Int?        @map("page_number")
  status     ChunkStatus @default(ACTIVE)
  embedding  Embedding?
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz

  document Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  org      Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([documentId, index])
  @@index([orgId, status])
  @@index([documentId])
  @@map("knowledge_chunks")
}

model Embedding {
  id        String   @id @default(uuid()) @db.Uuid
  chunkId   String   @unique @map("chunk_id") @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  model     String   @default("text-embedding-3-small")
  vector    Unsupported("vector(1536)")
  dimensions Int     @default(1536)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  chunk KnowledgeChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  org   Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("embeddings")
}

model MissingAnswer {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  conversationId String? @map("conversation_id") @db.Uuid
  question      String
  context       String?
  suggestedSource String? @map("suggested_source")
  status        String   @default("open")
