// ══════════════════════════════════════════════════════════
// Phase 18 — AI Observability
// ══════════════════════════════════════════════════════════

model AIFeedback {
  id             String   @id @default(uuid()) @db.Uuid
  orgId          String?  @map("org_id") @db.Uuid
  conversationId String?  @map("conversation_id") @db.Uuid
  rating         Int      @default(0)
  category       String   @default("general")
  comment        String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdAt])
  @@index([rating])
  @@map("ai_feedback")
}

model AIExperiment {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  modelA          String   @map("model_a") @default("gpt-4")
  modelB          String   @map("model_b") @default("gemini")
  promptKey       String?  @map("prompt_key")
  trafficPercent  Int      @default(50) @map("traffic_percent")
  active          Boolean  @default(true)
  metric          String   @default("quality_score")
  winner          String?
  totalSamples    Int      @default(0) @map("total_samples")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([active])
  @@map("ai_experiments")
}

model AIMonitorSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  model         String
  totalRequests Int      @default(0) @map("total_requests")
  avgLatency    Float    @default(0) @map("avg_latency")
  p95Latency    Float    @default(0) @map("p95_latency")
  errorRate     Float    @default(0) @map("error_rate")
  tokenCount    Int      @default(0) @map("token_count")
  cost          Decimal  @default(0) @db.Decimal(12, 6)
  snapshotAt    DateTime @default(now()) @map("snapshot_at") @db.Timestamptz

  @@index([model, snapshotAt])
  @@index([snapshotAt])
  @@map("ai_monitor_snapshots")
}

// ══════════════════════════════════════════════════════════
// Phase 17 — Production Hardening
// ══════════════════════════════════════════════════════════

enum IpRuleAction {
  ALLOW
  BLOCK
}

model ApiKey {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  keyPrefix   String   @map("key_prefix")
  keyHash     String   @unique @map("key_hash")
  scopes      Json     @default("[]")
  active      Boolean  @default(true)
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz

  @@index([keyPrefix])
  @@index([active])
  @@map("api_keys")
}

model IpRule {
  id          String       @id @default(uuid()) @db.Uuid
  cidr        String       @unique
  action      IpRuleAction @default(BLOCK)
  reason      String?
  expiresAt   DateTime?    @map("expires_at") @db.Timestamptz
  createdBy   String?      @map("created_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@index([action])
  @@map("ip_rules")
}

model RateLimitOverride {
  id          String   @id @default(uuid()) @db.Uuid
  route       String   @unique
  requests    Int      @default(60)
  windowSecs  Int      @default(60) @map("window_secs")
  description String?
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("rate_limit_overrides")
}

// ══════════════════════════════════════════════════════════
// Phase 16 — Infrastructure Ops
// ══════════════════════════════════════════════════════════

enum DeploymentStatus {
  PENDING
  IN_PROGRESS
  SUCCESS
  FAILED
  ROLLED_BACK
}

model InfraMetric {
  id         String   @id @default(uuid()) @db.Uuid
  type       String
  value      Float
  unit       String   @default("percent")
  label      String?
  tags       Json     @default("{}")
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz

  @@index([type, recordedAt])
  @@index([recordedAt])
  @@map("infra_metrics")
}

model Deployment {
  id          String           @id @default(uuid()) @db.Uuid
  version     String
  service     String           @default("admin-app")
  environment String           @default("production")
  status      DeploymentStatus @default(PENDING)
  commitHash  String?          @map("commit_hash")
  branch      String?
  author      String?
  duration    Int?             @default(0)
  changelog   Json             @default("[]")
  deployedBy  String?          @map("deployed_by") @db.Uuid
  startedAt   DateTime?        @map("started_at") @db.Timestamptz
  completedAt DateTime?        @map("completed_at") @db.Timestamptz
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@index([service, createdAt])
  @@index([environment, createdAt])
  @@map("deployments")
}

model ScheduledTask {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  cron        String
  type        String   @default("maintenance")
  active      Boolean  @default(true)
  lastRunAt   DateTime? @map("last_run_at") @db.Timestamptz
  lastStatus  String?  @map("last_status")
  nextRunAt   DateTime? @map("next_run_at") @db.Timestamptz
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([type, active])
  @@map("scheduled_tasks")
}

// ══════════════════════════════════════════════════════════
// Phase 14 — Support Ops Center
// ══════════════════════════════════════════════════════════

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

model SupportTicket {
  id         String        @id @default(uuid()) @db.Uuid
  orgId      String        @map("org_id") @db.Uuid
  subject    String
  status     TicketStatus  @default(OPEN)
  priority   TicketPriority @default(NORMAL)
  assignedTo String?       @map("assigned_to") @db.Uuid
  createdBy  String?       @map("created_by") @db.Uuid
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  org      Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignee Admin?        @relation("AssignedTickets", fields: [assignedTo], references: [id], onDelete: SetNull)
  creator  Admin?        @relation("CreatedTickets", fields: [createdBy], references: [id], onDelete: SetNull)
  messages SupportMessage[]

  @@index([orgId, createdAt])
  @@index([status])
  @@index([assignedTo])
  @@map("support_tickets")
}

model SupportMessage {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  adminId    String?  @map("admin_id") @db.Uuid
  authorName String   @map("author_name")
  content    String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  admin  Admin?        @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}
